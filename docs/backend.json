
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Additional information about the registered user.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phoneNumber": {
          "type": "string"
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Whether the user has administrative privileges."
        }
      }
    },
    "Product": {
      "title": "Product",
      "description": "Product details for the store.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "shippingPrice": { "type": "number" },
        "shippingNote": { "type": "string" },
        "deliveryTime": { "type": "string" },
        "guaranteeNote": { "type": "string" },
        "supportNote": { "type": "string" }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Product categories for the store.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object" } },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["جديد", "قيد التنفيذ", "تم الشحن", "تم التوصيل", "ملغي", "مسترجع"] },
        "shippingAddress": {
          "type": "object",
          "properties": {
            "recipientName": { "type": "string" },
            "addressLine1": { "type": "string" },
            "addressLine2": { "type": "string" },
            "city": { "type": "string" },
            "state": { "type": "string" },
            "postalCode": { "type": "string" },
            "countryCode": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store products."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Dynamic categories."
    },
    "/settings/{settingId}": {
      "schema": "Category",
      "description": "App settings."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders."
    }
  }
}
